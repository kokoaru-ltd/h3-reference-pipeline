VIDEO_PROVIDER=byteplus

BYTEPLUS_API_URL=https://operator.las.ap-southeast-1.bytepluses.com/api/v1/contents/generations/tasks
BYTEPLUS_API_KEY=
BYTEPLUS_SEEDANCE_MODEL=dreamina-seedance-2-0-mini-260615
BYTEPLUS_RESOLUTION=720p
BYTEPLUS_GENERATE_AUDIO=true
BYTEPLUS_CALLBACK_URL=
BYTEPLUS_REFERENCE_CONTENT=
# Optional callback endpoint; leave blank to use polling.

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional JSON map for multiple speakers, e.g. {"narrator":"voice_id","job_seeker":"voice_id"}
ELEVENLABS_VOICE_MAP_JSON=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_FALLBACK_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Optional local ChatGPT Web Gateway (browser session; no OpenAI API key)
CHATGPT_GATEWAY_URL=http://127.0.0.1:8000
CHATGPT_GATEWAY_API_TOKEN=dummy123
CHATGPT_GATEWAY_MODEL=chatgpt-web
CHATGPT_GATEWAY_IMAGE_MODEL=image-2
